{
  "name": "@tiangong-lca/study-report-renderer",
  "version": "2.0.0",
  "type": "module",
  "description": "Dependency-free frozen LCA Study report view",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
